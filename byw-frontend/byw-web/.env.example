# AI Agent 中间件接入配置模板
# 复制为 .env 后填写（.env 已被 .gitignore 忽略，不会提交）
#
# systemId / apiKey 由中间件的注册脚本生成，每个环境（开发/测试/生产）各自注册一个：
#   cd <AIAgent>/server && node --import tsx scripts/register-system.ts "byw-web-dev"
# 注意：脚本写入的是它运行时所在目录的 data/aam.db，必须与目标环境的中间件实例一致
# apiKey 明文仅输出一次，请妥善保存

NUXT_PUBLIC_AGENT_ENDPOINT=ws://localhost:3100/ws
NUXT_PUBLIC_AGENT_SYSTEM_ID=
NUXT_PUBLIC_AGENT_API_KEY=
