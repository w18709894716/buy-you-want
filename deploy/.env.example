# =============================================================================
# docker compose 需要的环境变量示例（复制为 deploy/.env，或在 shell 里 export）
#   docker compose -f deploy/docker-compose.yml up -d
#   docker compose -f deploy/docker-compose.app.yml up -d --build
# 说明：compose.app.yml 里 JASYPT_ENCRYPTOR_PASSWORD 用的是 ${VAR:?}，
# 缺失时 compose 会直接报错退出（而不是起一堆连不上数据库的容器）。
# =============================================================================

# 【必填】jasypt 主密钥：配置里的 ENC(...) 靠它解密；缺失则服务启动即失败（fail-closed）
# 生成方式见 docs/deploy/jasypt/README.md
JASYPT_ENCRYPTOR_PASSWORD=

# 【生产必填】HTTPS 下必须为 true，否则浏览器不会回传 HttpOnly Cookie
BYW_AUTH_COOKIE_SECURE=false

# 【生产必填】支付渠道回调验签密钥；不配置时真实回调会被全部拒绝（fail-closed）
BYW_PAY_CALLBACK_SECRET=

# 【跨域部署必填】前端域名白名单（同源部署 / Vite 代理时可不配）
BYW_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5174,http://localhost:5175

# 可选：模拟支付回调开关（生产必须 false）
BYW_PAY_MOCK_ENABLED=false
